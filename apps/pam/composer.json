{
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    },
    "platform-check": true,
    "sort-packages": true
  },
  "description": "PAM Native benchmark app (suite/SCENARIOS.md).",
  "license": "proprietary",
  "name": "app/pam-native-project",
  "require": {
    "php": "^8.5",
    "pushinbr/pam-native": "^1.0",
    "bench/localhost-cleartext": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "native:benchmark": "pam benchmark .",
    "native:build": "pam build . --release",
    "native:dev": "pam dev .",
    "native:doctor": "pam doctor .",
    "native:profile": "pam profile .",
    "test": "pam test . --phpunit -c phpunit.xml"
  },
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "packages/localhost-cleartext",
      "options": {
        "symlink": false
      }
    }
  ]
}
